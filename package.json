{
  "name": "dra-ana-beatriz-odontologia",
  "version": "1.0.0",
  "private": true,
  "description": "Site institucional premium da Dra. Ana Beatriz Lemos Souza — Cirurgiã-Dentista",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:site": "node scripts/check-site.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run format:check && npm run lint && npm run check:css && npm run typecheck && npm run test && npm run build && npm run check:site",
    "check:css": "node scripts/check-css.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.1",
    "@supabase/supabase-js": "^2.119.0",
    "clsx": "^2.1.1",
    "next": "^15.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "resend": "^6.38.0",
    "tailwind-merge": "^2.5.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@types/node": "^22.9.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^3.2.7",
    "autoprefixer": "^10.6.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.19",
    "postcss": "^8.5.32",
    "prettier": "^3.10.1",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.7.2",
    "vitest": "^3.2.7"
  },
  "browserslist": [
    "chrome >= 100",
    "edge >= 100",
    "firefox >= 100",
    "safari >= 15.4",
    "ios_saf >= 15.4"
  ],
  "engines": {
    "node": ">=20"
  }
}
